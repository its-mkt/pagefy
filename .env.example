# Claude API 키 (https://console.anthropic.com → API Keys). 이 파일을 .env 로 복사해 채운다. .env 는 커밋하지 않는다
ANTHROPIC_API_KEY=

# 마크업 규칙 파일 (기본: 마케팅팀 공유 폴더 원본을 바로 읽음 → 규칙을 고치면 다음 생성부터 바로 반영)
# 공유 폴더에 접근할 수 없으면 rules/detail_to_markup.md (사본)을 쓴다
RULES_FILE=\192.168.1.254\마케팅팀\A_상세페이지\detail_to_markup.md

# 모델·노력 수준 (기본: claude-opus-5-5 / high). CLAUDE_* 이름은 Claude Code 와 겹쳐서 PAGEFY_* 를 쓴다
PAGEFY_MODEL=claude-opus-5-5
PAGEFY_EFFORT=high

# 1 이면 Claude 를 부르지 않고 예시 응답을 돌려준다 (화면 흐름 점검용, 비용 없음)
MOCK=0

API_PORT=1101
