{
  "name": "pagefy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "description": "Pagefy — 통이미지 디자인(PSD)을 팀 규칙대로 HTML 마크업으로 변환 (React + TS + SCSS + Vite, Claude API)",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@supabase/supabase-js": "^2.119.2",
    "ag-psd": "^34.2.2",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "modern-screenshot": "4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "sass": "^1.108.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -b",
    "check:psd": "tsx scripts/check-psd.ts",
    "sync:rules": "tsx scripts/sync-rules.ts",
    "build:function": "tsx scripts/build-function.ts"
  }
}
